{
  "name": "my-life-organizer",
  "version": "1.2.0",
  "private": true,
  "description": "Offline-first personal life organizer built with HTML, CSS and Vanilla JavaScript, ready for Capacitor Android.",
  "scripts": {
    "build": "esbuild src/js/app.js --bundle --format=iife --platform=browser --target=es2020 --outfile=www/js/app.bundle.js",
    "watch": "npm run build -- --watch",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "patch:android": "node scripts/patch-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
